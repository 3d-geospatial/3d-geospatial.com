<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

  {# Compose the page title as a real string (not a captured rendered block)
     so it isn't double-HTML-escaped when interpolated into the document. #}
  {%- if title and (site.shortTitle not in title) and (title | length) < 60 -%}
    {%- set fullTitle = title + " — " + site.shortTitle -%}
  {%- elif title -%}
    {%- set fullTitle = title -%}
  {%- else -%}
    {%- set fullTitle = site.title -%}
  {%- endif -%}
  {%- set metaDesc = description if description else site.description -%}
  {%- set ogImg = site.url + (ogImage if ogImage else site.ogImage) -%}

  <title>{{ fullTitle }}</title>
  <meta name="description" content="{{ metaDesc }}">
  <meta name="keywords" content="{{ (keywords or site.keywords) | join(', ') }}">
  <meta name="author" content="{{ site.publisher.name }}">
  <meta name="theme-color" content="{{ site.themeColor }}" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0f171d" media="(prefers-color-scheme: dark)">
  <meta name="color-scheme" content="light dark">

  {# Resolve the theme before first paint: a stored choice wins, otherwise the
     OS preference. Runs inline in <head> so the page never flashes the wrong
     surface, and mirrors onto <html> so the CSS token set is picked at parse. #}
  <script>
    (function () {
      try {
        var stored = localStorage.getItem("theme");
        var theme = (stored === "dark" || stored === "light") ? stored
          : (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      } catch (e) {
        document.documentElement.setAttribute("data-theme", "light");
      }
    })();
  </script>
  <meta name="generator" content="Eleventy">
  <meta name="format-detection" content="telephone=no">
  <meta name="robots" content="{{ robots or 'index,follow,max-image-preview:large' }}">
  <meta name="googlebot" content="{{ robots or 'index,follow,max-image-preview:large' }}">

  {# Canonical & sitemap #}
  <link rel="canonical" href="{{ canonicalUrl }}">
  <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">

  {# Icons (favicon + PWA) #}
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/assets/img/logo.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/icon-32.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/img/icon-192.png">
  <link rel="manifest" href="/manifest.webmanifest">

  {# Apple home screen #}
  <link rel="apple-touch-icon" href="/assets/img/icon-180.png">
  <link rel="mask-icon" href="/assets/img/logo.svg" color="{{ site.themeColor }}">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="{{ site.shortTitle }}">
  <meta name="application-name" content="{{ site.shortTitle }}">

  {# Open Graph #}
  <meta property="og:type" content="{% if page.url and page.url != '/' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ fullTitle }}">
  <meta property="og:description" content="{{ metaDesc }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:image" content="{{ ogImg }}">
  <meta property="og:image:width" content="{{ site.ogImageWidth }}">
  <meta property="og:image:height" content="{{ site.ogImageHeight }}">
  <meta property="og:image:alt" content="{{ site.ogImageAlt }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="{{ site.locale }}">
  {% if page.url and page.url != "/" %}
  <meta property="article:published_time" content="{{ dateModified }}">
  <meta property="article:modified_time" content="{{ dateModified }}">
  <meta property="article:publisher" content="{{ site.url }}/">
  {% endif %}

  {# Twitter Card #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ fullTitle }}">
  <meta name="twitter:description" content="{{ metaDesc }}">
  <meta name="twitter:image" content="{{ ogImg }}">
  <meta name="twitter:image:alt" content="{{ site.ogImageAlt }}">

  {# Performance hints #}
  <link rel="preload" href="/assets/css/styles.css?v={{ assets.cssVersion }}" as="style">
  {% if hasMermaid %}
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  {% endif %}

  <link rel="stylesheet" href="/assets/css/styles.css?v={{ assets.cssVersion }}">

  {# Structured data #}
  {% include "partials/jsonld.njk" %}
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>

  {% include "partials/header.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <script src="/assets/js/site.js?v={{ assets.jsVersion }}" defer></script>
  {% if hasMermaid %}
    <script type="module">
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";
      mermaid.initialize({
        startOnLoad: true,
        theme: "base",
        themeVariables: {
          background: "#ffffff",
          primaryColor: "#e3f0f4",
          primaryTextColor: "#1f2937",
          primaryBorderColor: "#1f6b8a",
          lineColor: "#5b6471",
          secondaryColor: "#fdf3e0",
          tertiaryColor: "#eef5e9",
          fontFamily: "ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif"
        }
      });
    </script>
  {% endif %}
</body>
</html>
