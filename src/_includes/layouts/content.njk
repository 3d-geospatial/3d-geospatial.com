---
layout: layouts/base.njk
---
{# Per-page title is derived from first H1 of markdown via eleventyComputed. #}
{% set crumbs = page.url | breadcrumbs %}

<div class="container">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    {% for c in crumbs %}
      {% if loop.last %}
        <span class="current">{{ c.label | titleCase }}</span>
      {% else %}
        <a href="{{ c.url }}">{{ c.label | titleCase }}</a>
        <span class="sep" aria-hidden="true">›</span>
      {% endif %}
    {% endfor %}
  </nav>

  <div class="content-page">
    <article class="article">
      {{ content | safe }}

      {% set children = collections.contentPages | childrenOf(page.url) | byTitle %}
      {% set siblings = collections.contentPages | siblingsOf(page.url) | byTitle %}

      <div class="related-nav">
        {% if children.length > 0 %}
          <div>
            <h3>Explore further</h3>
            <div class="related-grid">
              {% for kid in children %}
                <a class="related-card" href="{{ kid.url }}">
                  <span class="related-card__label">In this section</span>
                  <span class="related-card__title">{{ kid.data.title or (kid.fileSlug | titleCase) }}</span>
                </a>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        {% if siblings.length > 0 %}
          <div>
            <h3>Related</h3>
            <div class="related-grid">
              {% for sib in siblings %}
                <a class="related-card" href="{{ sib.url }}">
                  <span class="related-card__label">Sibling topic</span>
                  <span class="related-card__title">{{ sib.data.title or (sib.fileSlug | titleCase) }}</span>
                </a>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>
    </article>

    {# On-page TOC sidebar (built client-side from h2/h3) #}
    <aside class="toc" aria-label="On this page" data-toc hidden>
      <h4>On this page</h4>
      <ul></ul>
    </aside>
  </div>
</div>
