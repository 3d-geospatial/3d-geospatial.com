<footer class="site-footer" role="contentinfo">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a href="{{ site.url }}/" class="brand" aria-label="{{ site.title }} — home">
        <img src="/assets/img/logo-mark.svg" alt="" class="brand__mark" width="36" height="36">
        <span class="brand__name">
          3D Geospatial
          <small>Digital Twin Automation</small>
        </span>
      </a>
      <p>Engineering-grade guides on point cloud processing, mesh pipelines, LOD strategies, and CI/CD automation for digital twin platforms.</p>
      <a class="footer-social" href="https://github.com/3d-geospatial" aria-label="3D Geospatial on GitHub" rel="noopener" target="_blank">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
          <path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.36-3.88-1.36-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.75.4-1.27.73-1.56-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.19-3.08-.12-.3-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.75.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.07.78 2.15v3.18c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/>
        </svg>
        <span>GitHub</span>
      </a>
    </div>

    <div class="site-footer__col">
      <h4>Sections</h4>
      <ul>
        <li><a href="{{ site.url }}/">Home</a></li>
        {% for sec in collections.topSections %}
          <li><a href="{{ site.url }}{{ sec.url }}">{{ sec.data.sectionTitle }}</a></li>
        {% endfor %}
      </ul>
    </div>

    {% for sec in collections.topSections %}
      <div class="site-footer__col">
        <h4>{{ sec.data.sectionTitle }}</h4>
        <ul>
          {% set kids = collections.contentPages | childrenOf(sec.url) | byTitle %}
          {% for kid in kids %}
            <li><a href="{{ site.url }}{{ kid.url }}">{{ kid.data.title or (kid.fileSlug | titleCase) }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endfor %}
  </div>
  <div class="container site-footer__bottom">
    <span>© {% year %} {{ site.title }}</span>
    <span>Built with Eleventy · PWA-enabled</span>
  </div>
</footer>
