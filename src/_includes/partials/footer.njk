<footer class="site-footer" role="contentinfo">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a href="{{ site.url }}/" class="brand" aria-label="{{ site.title }} — home">
        <img src="/assets/img/logo-mark.svg" alt="" class="brand__mark" width="36" height="36">
        <span class="brand__name">
          3D Geospatial
          <small>Digital Twin Automation</small>
        </span>
      </a>
      <p>Engineering-grade guides on point cloud processing, mesh pipelines, LOD strategies, and CI/CD automation for digital twin platforms.</p>
    </div>

    <div class="site-footer__col">
      <h4>Sections</h4>
      <ul>
        <li><a href="{{ site.url }}/">Home</a></li>
        {% for sec in collections.topSections %}
          <li><a href="{{ site.url }}{{ sec.url }}">{{ sec.data.sectionTitle }}</a></li>
        {% endfor %}
      </ul>
    </div>

    {% for sec in collections.topSections %}
      <div class="site-footer__col">
        <h4>{{ sec.data.sectionTitle }}</h4>
        <ul>
          {% set kids = collections.contentPages | childrenOf(sec.url) | byTitle %}
          {% for kid in kids %}
            <li><a href="{{ site.url }}{{ kid.url }}">{{ kid.data.title or (kid.fileSlug | titleCase) }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endfor %}
  </div>
  <div class="container site-footer__bottom">
    <span>© {% year %} {{ site.title }}</span>
    <span>Built with Eleventy · PWA-enabled</span>
  </div>
</footer>
