{# Sticky site header with logo, primary nav, current-page indicator #}
<header class="site-header" role="banner">
  <div class="container site-header__inner">
    <a href="{{ site.url }}/" class="brand" aria-label="{{ site.title }} — home">
      <img src="/assets/img/logo.svg" alt="" class="brand__mark" width="36" height="36">
      <span class="brand__name">
        3D Geospatial
        <small>Digital Twin Automation</small>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-nav-toggle>
      <span class="nav-toggle__icon" aria-hidden="true"><span></span></span>
      Menu
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Primary">
      {% set isHome = page.url == "/" %}
      <a href="{{ site.url }}/" {% if isHome %}aria-current="page"{% endif %}>
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 12 12 3l9 9"/><path d="M5 10v10h14V10"/>
        </svg>
        Home
      </a>
      {% for sec in collections.topSections %}
        {% set active = page.url and page.url.startsWith(sec.url) %}
        <a href="{{ site.url }}{{ sec.url }}" {% if active %}aria-current="page"{% endif %}>
          {% if sec.data.sectionKey == "fundamentals" %}
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2 3 7l9 5 9-5z"/><path d="M3 12l9 5 9-5"/><path d="M3 17l9 5 9-5"/>
            </svg>
          {% elif sec.data.sectionKey == "lod" %}
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
              <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
            </svg>
          {% elif sec.data.sectionKey == "troubleshooting" %}
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
              <path d="M12 9v4"/><path d="M12 17h.01"/>
            </svg>
          {% else %}
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="6" cy="6" r="1.5"/><circle cx="12" cy="6" r="1.5"/><circle cx="18" cy="6" r="1.5"/>
              <circle cx="6" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="18" cy="12" r="1.5"/>
              <circle cx="6" cy="18" r="1.5"/><circle cx="12" cy="18" r="1.5"/><circle cx="18" cy="18" r="1.5"/>
            </svg>
          {% endif %}
          {{ sec.data.sectionTitle }}
        </a>
      {% endfor %}
    </nav>
  </div>
</header>
