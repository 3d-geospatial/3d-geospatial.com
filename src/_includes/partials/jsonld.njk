{# JSON-LD structured data. Always emits Organization + WebSite.
   On content pages also emits TechArticle + BreadcrumbList.        #}

{%- set baseUrl = site.url | trim -%}
{%- set logoAbs = baseUrl + site.publisher.logo -%}
{%- set ogImageAbs = baseUrl + site.ogImage -%}

{%- set organization = {
  "@type": "Organization",
  "@id": baseUrl + "/#organization",
  "name": site.publisher.name,
  "url": baseUrl + "/",
  "logo": {
    "@type": "ImageObject",
    "url": logoAbs,
    "width": 512,
    "height": 512
  }
} -%}

{%- set website = {
  "@type": "WebSite",
  "@id": baseUrl + "/#website",
  "url": baseUrl + "/",
  "name": site.title,
  "description": site.description,
  "inLanguage": site.lang,
  "publisher": { "@id": baseUrl + "/#organization" }
} -%}

{%- set graph = [organization, website] -%}

{%- if page.url and page.url != "/" -%}
  {%- set crumbs = page.url | breadcrumbs -%}
  {%- set itemList = [] -%}
  {%- for c in crumbs -%}
    {%- set itemList = (itemList.push({
      "@type": "ListItem",
      "position": loop.index,
      "name": c.label | titleCase,
      "item": baseUrl + c.url
    }), itemList) -%}
  {%- endfor -%}

  {%- set breadcrumb = {
    "@type": "BreadcrumbList",
    "@id": canonicalUrl + "#breadcrumb",
    "itemListElement": itemList
  } -%}

  {%- set article = {
    "@type": "TechArticle",
    "@id": canonicalUrl + "#article",
    "isPartOf": { "@id": baseUrl + "/#website" },
    "headline": title,
    "name": title,
    "description": description,
    "url": canonicalUrl,
    "mainEntityOfPage": canonicalUrl,
    "inLanguage": site.lang,
    "datePublished": dateModified,
    "dateModified": dateModified,
    "author": { "@id": baseUrl + "/#organization" },
    "publisher": { "@id": baseUrl + "/#organization" },
    "image": {
      "@type": "ImageObject",
      "url": ogImageAbs,
      "width": site.ogImageWidth,
      "height": site.ogImageHeight
    },
    "breadcrumb": { "@id": canonicalUrl + "#breadcrumb" }
  } -%}

  {%- set graph = (graph.push(article), graph.push(breadcrumb), graph) -%}
{%- endif -%}

<script type="application/ld+json">
{{ { "@context": "https://schema.org", "@graph": graph } | dump(2) | safe }}
</script>
