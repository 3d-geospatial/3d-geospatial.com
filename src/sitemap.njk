---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
    <lastmod>{{ dateModified }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
{%- for item in collections.contentPages %}
  {%- set segs = item.url.split('/') %}
  {%- set depth = (segs.length - 2) %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    <lastmod>{{ item.data.dateModified }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>{% if depth == 1 %}0.9{% elif depth == 2 %}0.7{% else %}0.5{% endif %}</priority>
  </url>
{%- endfor %}
</urlset>
